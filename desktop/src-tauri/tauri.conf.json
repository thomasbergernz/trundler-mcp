{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Trundler",
  "version": "0.1.0",
  "identifier": "nz.aaic.trundler",
  "build": {
    "beforeDevCommand": "node scripts/build-server.mjs",
    "beforeBuildCommand": "node scripts/build-server.mjs"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/node"],
    "resources": {
      "../server-dist/server": "server"
    }
  }
}
